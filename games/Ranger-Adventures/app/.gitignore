# public/{audio,models,draco}: now TRACKED — the optimized ~25MB cast is the deploy
# payload; CI's build:site reads them to emit /ranger. (Raw 790MB intermediates in
# assets-gen/ stay ignored.)

# Playwright output (incl. the golden path's test-results/golden/NN-<step>.png +
# SUMMARY.txt) stays out of git. No spec writes into a tracked folder.
test-results/
playwright-report/
e2e/__shots__/
# Optional Meshy/Mixamo ingest drop (W3.1) — raw GLBs never committed here.
incoming/

# Benjamin's voice: texts the dev server heard with no clip yet (npm run voice records them)
scripts/voice-missed.txt
